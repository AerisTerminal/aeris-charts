{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../../packages/charts run build && node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const [source,target] of [['index.js','nucleuscharts_financial.js'],['index.js.map','index.js.map'],['nucleuscharts_wasm_bg.wasm','nucleuscharts_wasm_bg.wasm'],['nucleuscharts.css','nucleuscharts.css'],['inter_400.ttf','inter_400.ttf']])fs.copyFileSync('../../packages/charts/dist/'+source,'dist/'+target)\"",
    "test:browser": "playwright test",
    "test:gpui-webgpu": "npm run build && node run_gpui_webgpu_matrix.mjs"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@playwright/test": "1.61.1",
    "lightweight-charts": "5.2.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0"
  }
}
