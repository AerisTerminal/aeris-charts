{
  "name": "@axiusflowhq/charts",
  "version": "0.8.12",
  "type": "module",
  "description": "High-performance financial charting SDK powered by Rust, WebAssembly, and WebGPU.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Axiusflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axiusflowhq/Axiusflow_Charts.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/Axiusflowhq/Axiusflow_Charts/issues"
  },
  "homepage": "https://github.com/Axiusflowhq/Axiusflow_Charts#readme",
  "keywords": [
    "axiusflow",
    "charts",
    "charting",
    "trading",
    "financial-charts",
    "candlestick",
    "finance",
    "market-data",
    "webgpu",
    "wasm",
    "webassembly",
    "rust"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/index.js.map"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('pkg',{recursive:true,force:true})\"",
    "build:wasm": "wasm-pack build ../../crates/origin_wasm --target web --out-dir ../../packages/charts/pkg",
    "build:js": "esbuild src/index.ts --bundle --format=esm --sourcemap --outfile=dist/index.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:copy-wasm": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('pkg/origin_wasm_bg.wasm','dist/origin_wasm_bg.wasm')\"",
    "build": "npm run build:wasm && npm run build:js && npm run build:types && npm run build:copy-wasm",
    "lint": "oxlint src",
    "test:pack": "node scripts/pack_smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run test:pack"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  }
}
