{
  "name": "@nucleuscharts/financial",
  "version": "0.9.0",
  "type": "module",
  "description": "Financial charting SDK powered by Rust, WebAssembly, and WebGPU.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "NucleusCharts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NucleusCharts/financial-charts.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/NucleusCharts/financial-charts/issues"
  },
  "homepage": "https://github.com/NucleusCharts/financial-charts#readme",
  "keywords": [
    "nucleuscharts",
    "charts",
    "charting",
    "trading",
    "financial-charts",
    "candlestick",
    "finance",
    "market-data",
    "webgpu",
    "wasm",
    "webassembly",
    "rust"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design.css": "./dist/nucleuscharts.css"
  },
  "files": [
    "dist",
    "!dist/index.js.map"
  ],
  "sideEffects": [
    "./dist/nucleuscharts.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:namespace": "node scripts/namespace_guard.mjs",
    "check:api": "node scripts/api_surface.mjs",
    "update:api": "node scripts/api_surface.mjs --update",
    "check:release-gates": "node scripts/release_gate_guard.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('pkg',{recursive:true,force:true})\"",
    "build:wasm": "wasm-pack build ../../crates/nucleuscharts_wasm --target web --out-dir ../../packages/charts/pkg",
    "build:js": "esbuild src/index.ts --bundle --format=esm --sourcemap --outfile=dist/index.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:copy-wasm": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('pkg/nucleuscharts_wasm_bg.wasm','dist/nucleuscharts_wasm_bg.wasm')\"",
    "build:copy-design": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/nucleuscharts.css','dist/nucleuscharts.css');fs.copyFileSync('../../crates/nucleuscharts_native/assets/Inter.ttf','dist/inter_400.ttf')\"",
    "build": "npm run build:wasm && npm run build:js && npm run build:types && npm run build:copy-wasm && npm run build:copy-design",
    "lint": "oxlint src",
    "test:pack": "node scripts/pack_smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run check:api && npm run check:release-gates && npm run test:pack"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  }
}
